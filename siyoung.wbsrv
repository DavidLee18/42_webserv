types =
	html|htm -> text/html
	css      -> text/css
	js       -> application/javascript
	json     -> application/json
	jpg|jpeg -> image/jpeg
	png      -> image/png
	_        -> application/octet-stream

uwsgi =
	/uwsgi/login.py:9000
	/uwsgi/handle_additional_errors.py:9090


:8080 =
	[] +<= X-Content-Type-Options: "nosniff";

	$add_csp_sha256.cgi

	...300

	GET /old_stuff/ =301> /new_stuff/

	GET /old_stuff/* =301> /new_stuff/*

	GET /download/*/mp3/*.mp3 =301> /*/mp3/*

	GET /download/ <i- /spool/www/

	GET *.(jpg|jpeg|gif) <- /spool/www/*

	GET /cgi-test/echo     $/spool/www/cgi-bin/echo.cgi

	POST /storage/ <- /spool/www/storage/
		+> spool/www/storage/
		->{} 10MB
		@ auth_info
		! 400:/tmp/error_400.html
		! 413:/tmp/error_413.html
		! 500:/tmp/error_500.html

	POST|DELETE /storage/* <- /spool/www/storage/*
		->{} 10MB
		@ auth_info
		! 400:/tmp/error_400.html
		! 413:/tmp/error_413.html
		! 500:/tmp/error_500.html

	GET|POST|DELETE * <- /spool/www/*
		? hello.html
		@ auth_info
		->{} 10MB
		! 400:/spool/www/error/400.html
		! 401:/spool/www/error/401.html
		! 403:/spool/www/error/403.html
		! 404:/spool/www/error/404.html
		! 405:/spool/www/error/405.html
		! 409:/spool/www/error/409.html
		! 413:/spool/www/error/413.html
		! 500:/spool/www/error/500.html

