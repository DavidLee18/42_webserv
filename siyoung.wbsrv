types =
    html|htm -> text/html
    css      -> text/css
    js       -> application/javascript
    json     -> application/json
    jpg|jpeg -> image/jpeg
    png      -> image/png
    _        -> application/octet-stream




:8080 =
	[] +<= X-Content-Type-Options: "nosniff"

    ...30

    GET /old_stuff/* =301> /new_stuff/*

    GET /download/*/mp3/* =301> /*/mp3/*.mp3

    GET /download/ <i- /spool/www

    GET *.(jpg|jpeg|gif) <- /spool/www/*.(jpg|jpeg|gif)

    GET|POST|DELETE * <- /spool/www/*
        ? index2.html
        @ auth_info
        ->{} 10MB
        ! 400:/error/400.html
        ! 401:/error/401.html
        ! 403:/error/403.html
        ! 404:/error/404.html
        ! 405:/error/405.html
        ! 409:/error/409.html
        ! 413:/error/413.html
        ! 500:/error/500.html


:8040 =
	[] +<= X-Content-Type-Options: "nosniff"

    ...30

    GET /old_stuff/* =301> /new_stuff/*

    GET /download/*/mp3/* =301> /*/mp3/*.mp3

    GET /download/ <i- /spool/www

    GET *.(jpg|jpeg|gif) <- /spool/www/*.(jpg|jpeg|gif)

    GET|POST|DELETE * <- /spool/www/*
        ? 
        @ auth_info
        ->{} 10MB
        ! 400:/error/400.html
        ! 401:/error/401.html
        ! 403:/error/403.html
        ! 404:/error/404.html
        ! 405:/error/405.html
        ! 409:/error/409.html
        ! 413:/error/413.html
        ! 500:/error/500.html
